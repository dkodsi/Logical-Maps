Classicism.Meta.Intensional.FiniteCompression.central_countermodel :
  Classicism.Meta.Intensional.FiniteCompression.model.IsModel ∧
    Classicism.Meta.Intensional.FiniteCompression.model.HoldsAx Classicism.P.TameRigidity.schema ∧
      Classicism.Meta.Intensional.FiniteCompression.model.HoldsAx Classicism.P.RigidPower.schema ∧
        ¬Classicism.Meta.Intensional.FiniteCompression.model.HoldsSentence
            (Classicism.P.WeaklyRigidPower.quoted Classicism.Meta.Intensional.FiniteCompression.et)
Classicism.Meta.Intensional.FiniteCompression.not_entails_weakly_rigid_power :
  ¬Classicism.Meta.Intensional.FiniteCompression.Background ⟹ Classicism.P.WeaklyRigidPower.schema
