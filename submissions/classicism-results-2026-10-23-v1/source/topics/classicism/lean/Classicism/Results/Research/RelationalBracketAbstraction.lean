import Classicism.Syntax.Term

/-!
# Typed bracket abstraction in the relational type system

Original research, misc, 23 October 2026. The ordinary algorithm was audited
in the operator-characterization research session. This file is a syntactic
component of the inverse translation, not a whole-C equivalence certificate.

The independently defined terms below have variables, typed constants and
application only. `Meta.Var` and its explicit-type-argument renamings are
reused; `Meta.Term`, its lambda constructor, and C derivations are not used.
The equality relation has ordinary equational congruence and exactly the five
displayed combinator laws. No abstraction/conversion rule is a constructor.

The theorem is conditional on those combinator laws. Interpreting their fixed
typed constants by actual strong-comprehension witnesses, proving equality
coherence for the entire C language, and erasing the finitely many names are
separate integration obligations. No external function space is postulated.
-/

namespace Classicism.Research.RelationalBracketAbstraction
open Classicism.Meta (Ty RTy Ctx Var Ren)

/-- Fixed combinators indexed only by types, together with the old signature.
Only S requires its intermediate argument type to be relational. C and W
allow any type, including e and opaque type variables. -/
inductive BasisConst (Const : Ty → Type) : Ty → Type
  | original {σ} : Const σ → BasisConst Const σ
  | I (ρ : RTy) : BasisConst Const (ρ ⇒ ρ)
  | K (σ : Ty) (ρ : RTy) : BasisConst Const (ρ ⇒ σ ⇒ ρ)
  | S (σ : Ty) (τ ρ : RTy) :
      BasisConst Const ((σ ⇒ τ ⇒ ρ) ⇒ (σ ⇒ τ) ⇒ σ ⇒ ρ)
  | C (σ τ : Ty) (ρ : RTy) : BasisConst Const ((σ ⇒ τ ⇒ ρ) ⇒ τ ⇒ σ ⇒ ρ)
  | W (σ : Ty) (ρ : RTy) : BasisConst Const ((σ ⇒ σ ⇒ ρ) ⇒ σ ⇒ ρ)

inductive Term (Const : Ty → Type) : Ctx → Ty → Type
  | var {Γ σ} : Var Γ σ → Term Const Γ σ
  | const {Γ σ} : BasisConst Const σ → Term Const Γ σ
  | app {Γ σ} {ρ : RTy} :
      Term Const Γ (σ ⇒ ρ) → Term Const Γ σ → Term Const Γ ρ

/-- Syntax substitutions with an explicit type argument, not an implicit Π. -/
abbrev Sub (Const : Ty → Type) (Γ Δ : Ctx) := ∀ σ, Var Γ σ → Term Const Δ σ

namespace Sub
def id : Sub Const Γ Γ := fun _ v => .var v
def cons (a : Term Const Δ σ) (s : Sub Const Γ Δ) : Sub Const (σ :: Γ) Δ
  | _, .zero => a
  | _, .succ v => s _ v
end Sub

namespace Term
variable {Const : Ty → Type}

def rename {Γ Δ σ} (r : Ren Γ Δ) : Term Const Γ σ → Term Const Δ σ
  | .var v => .var (r _ v)
  | .const c => .const c
  | .app f a => .app (rename r f) (rename r a)

def wk {Γ σ τ} (a : Term Const Γ τ) : Term Const (σ :: Γ) τ :=
  a.rename Classicism.Meta.Ren.shift

def subst {Γ Δ σ} (s : Sub Const Γ Δ) : Term Const Γ σ → Term Const Δ σ
  | .var v => s _ v
  | .const c => .const c
  | .app f a => .app (subst s f) (subst s a)

def inst {Γ σ τ} (M : Term Const (σ :: Γ) τ) (a : Term Const Γ σ) : Term Const Γ τ :=
  M.subst (Sub.cons a Sub.id)

theorem subst_id {Γ σ} (M : Term Const Γ σ) : M.subst Sub.id = M := by
  induction M <;> simp_all only [subst, Sub.id]

theorem subst_rename {Γ Δ Θ σ} (s : Sub Const Δ Θ) (r : Ren Γ Δ)
    (M : Term Const Γ σ) :
    (M.rename r).subst s = M.subst (fun τ v => s τ (r τ v)) := by
  induction M <;> simp_all only [rename, subst]

theorem inst_wk {Γ σ τ} (M : Term Const Γ τ) (a : Term Const Γ σ) :
    M.wk.inst a = M := by
  rw [inst, wk, subst_rename]
  exact subst_id M

/-- Remove the innermost variable from a relational-output term.

At nonrelational input types a term is necessarily a variable or constant.
The zero-variable case uses W; the two independent cases use C. This is a
syntactic test on the de Bruijn index, never an object-identity test.
In particular the algorithm does not manufacture a forbidden e→e term. -/
def bracket : {Γ : Ctx} → {σ : Ty} → {ρ : RTy} →
    Term Const (σ :: Γ) ρ → Term Const Γ (σ ⇒ ρ)
  | _, _, ρ, .var .zero => .const (.I ρ)
  | _, σ, ρ, .var (.succ v) => .app (.const (.K σ ρ)) (.var v)
  | _, σ, ρ, .const c => .app (.const (.K σ ρ)) (.const c)
  | _, σ, ρ, @Term.app _ _ (.rel τ) _ f a =>
      .app (.app (.const (.S σ τ ρ)) (bracket f)) (bracket a)
  | _, _, ρ, @Term.app _ _ .e _ f (.var .zero) =>
      .app (.const (.W .e ρ)) (bracket f)
  | _, σ, ρ, @Term.app _ _ .e _ f (.var (.succ v)) =>
      .app (.app (.const (.C σ .e ρ)) (bracket f)) (.var v)
  | _, σ, ρ, @Term.app _ _ .e _ f (.const c) =>
      .app (.app (.const (.C σ .e ρ)) (bracket f)) (.const c)
  | _, _, ρ, @Term.app _ _ (.var i) _ f (.var .zero) =>
      .app (.const (.W (.var i) ρ)) (bracket f)
  | _, σ, ρ, @Term.app _ _ (.var i) _ f (.var (.succ v)) =>
      .app (.app (.const (.C σ (.var i) ρ)) (bracket f)) (.var v)
  | _, σ, ρ, @Term.app _ _ (.var i) _ f (.const c) =>
      .app (.app (.const (.C σ (.var i) ρ)) (bracket f)) (.const c)

end Term

/-- Object-syntax equality generated by equational congruence and the five
typed combinator laws. There is no lambda, beta, eta, abstraction-congruence,
or extensionality constructor. -/
inductive Equal (Const : Ty → Type) : {Γ : Ctx} → {σ : Ty} →
    Term Const Γ σ → Term Const Γ σ → Prop
  | refl (a : Term Const Γ σ) : Equal Const a a
  | symm {a b : Term Const Γ σ} : Equal Const a b → Equal Const b a
  | trans {a b c : Term Const Γ σ} : Equal Const a b → Equal Const b c → Equal Const a c
  | app {ρ : RTy} {f g : Term Const Γ (σ ⇒ ρ)} {a b : Term Const Γ σ} :
      Equal Const f g → Equal Const a b → Equal Const (.app f a) (.app g b)
  | lawI {ρ : RTy} (a : Term Const Γ ρ) :
      Equal Const (.app (.const (.I ρ)) a) a
  | lawK {ρ : RTy} (a : Term Const Γ ρ) (b : Term Const Γ σ) :
      Equal Const (.app (.app (.const (.K σ ρ)) a) b) a
  | lawS {τ ρ : RTy} (f : Term Const Γ (σ ⇒ τ ⇒ ρ))
      (g : Term Const Γ (σ ⇒ τ)) (a : Term Const Γ σ) :
      Equal Const (.app (.app (.app (.const (.S σ τ ρ)) f) g) a)
        (.app (.app f a) (.app g a))
  | lawC {ρ : RTy} (f : Term Const Γ (σ ⇒ τ ⇒ ρ))
      (b : Term Const Γ τ) (a : Term Const Γ σ) :
      Equal Const (.app (.app (.app (.const (.C σ τ ρ)) f) b) a)
        (.app (.app f a) b)
  | lawW {ρ : RTy} (f : Term Const Γ (σ ⇒ σ ⇒ ρ)) (a : Term Const Γ σ) :
      Equal Const (.app (.app (.const (.W σ ρ)) f) a) (.app (.app f a) a)

namespace Equal
variable {Const : Ty → Type}

/-- Substitution preserves the generated equality by induction on its actual
constructors. This is proved, not assumed as an interpretation interface. -/
theorem subst {Γ Δ σ} (s : Sub Const Γ Δ) {a b : Term Const Γ σ}
    (h : Equal Const a b) : Equal Const (a.subst s) (b.subst s) := by
  induction h with
  | refl a => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | app _ _ ih₁ ih₂ => exact .app ih₁ ih₂
  | lawI a => exact .lawI _
  | lawK a b => exact .lawK _ _
  | lawS f g a => exact .lawS _ _ _
  | lawC f b a => exact .lawC _ _ _
  | lawW f a => exact .lawW _ _

end Equal

namespace Term
variable {Const : Ty → Type}

/-- Actual beta identity for the structural algorithm, for arbitrary
parameters and every admitted syntactic argument. The proof uses only the
five displayed laws and application congruence. -/
theorem bracket_beta : {Γ : Ctx} → {σ : Ty} → {ρ : RTy} →
    (M : Term Const (σ :: Γ) ρ) → (a : Term Const Γ σ) →
    Equal Const (.app M.bracket a) (M.inst a)
  | _, _, _, .var .zero, a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .lawI a
  | _, _, _, .var (.succ v), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .lawK (.var v) a
  | _, _, _, .const c, a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .lawK (.const c) a
  | _, _, _, @Term.app _ _ (.rel _) _ f b, a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawS f.bracket b.bracket a)
        (.app (bracket_beta f a) (bracket_beta b a))
  | _, _, _, @Term.app _ _ .e _ f (.var .zero), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawW f.bracket a) (.app (bracket_beta f a) (.refl a))
  | _, _, _, @Term.app _ _ .e _ f (.var (.succ v)), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawC f.bracket (.var v) a)
        (.app (bracket_beta f a) (.refl (.var v)))
  | _, _, _, @Term.app _ _ .e _ f (.const c), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawC f.bracket (.const c) a)
        (.app (bracket_beta f a) (.refl (.const c)))
  | _, _, _, @Term.app _ _ (.var _) _ f (.var .zero), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawW f.bracket a) (.app (bracket_beta f a) (.refl a))
  | _, _, _, @Term.app _ _ (.var _) _ f (.var (.succ v)), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawC f.bracket (.var v) a)
        (.app (bracket_beta f a) (.refl (.var v)))
  | _, _, _, @Term.app _ _ (.var _) _ f (.const c), a => by
      simp only [bracket, inst, subst, Sub.cons, Sub.id]
      exact .trans (.lawC f.bracket (.const c) a)
        (.app (bracket_beta f a) (.refl (.const c)))

end Term

#print axioms Term.bracket_beta
#print axioms Equal.subst

end Classicism.Research.RelationalBracketAbstraction
