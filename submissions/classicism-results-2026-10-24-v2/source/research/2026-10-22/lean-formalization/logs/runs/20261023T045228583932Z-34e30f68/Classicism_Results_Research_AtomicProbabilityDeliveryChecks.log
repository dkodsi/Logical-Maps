Classicism.Research.Probability.FiniteSupportSystem.residual_add.{u, v, w} {R : Type u}
  {s : Classicism.Research.Probability.MassScalar R} {E : Type v} {K : Type w}
  (F : Classicism.Research.Probability.FiniteSupportSystem s E K) {p q : E} {x y z : R} (hd : F.disjoint p q)
  (hx : F.Value p x) (hy : F.Value q y) (hz : F.Value (F.join p q) z) (mu : E → R)
  (hm : mu (F.join p q) = s.add (mu p) (mu q)) : s.sub (mu (F.join p q)) z = s.add (s.sub (mu p) x) (s.sub (mu q) y)
Classicism.Research.Probability.FiniteSupportSystem.completely_additive_graph.{u, v, w, z} {R : Type u}
  {s : Classicism.Research.Probability.MassScalar R} {E : Type v} {K : Type w} {I : Type z}
  (F : Classicism.Research.Probability.FiniteSupportSystem s E K) (f : I → E) (v : I → R)
  (hv : ∀ (i : I), F.Value (f i) (v i)) (p : E) (x : R) (hx : F.Value p x)
  (hdisjoint : ∀ (is : List I), is.Nodup → F.JoinCompatible f is)
  (hupper : ∀ (is : List I), is.Nodup → ∀ (k : K), F.below k (F.joinList f is) → F.below k p)
  (hcover : ∀ (k : K), F.below k p → ∃ is, is.Nodup ∧ F.below k (F.joinList f is)) :
  Classicism.Research.Probability.IsMassSup s (fun r => ∃ is, is.Nodup ∧ r = s.sum v is) x
Classicism.Research.Probability.FiniteSupportSystem.normalize_atomic_state.{u, v, w} {R : Type u}
  {s : Classicism.Research.Probability.MassScalar R} {E : Type v} {K : Type w}
  (F : Classicism.Research.Probability.FiniteSupportSystem s E K) (T : Classicism.Research.Probability.PositiveScale s)
  (v : E → R) (hv : ∀ (p : E), F.Value p (v p)) (top : E) (one : R) (hnorm : T.forward (v top) = one)
  (nonzero : E → Prop) (hfaithful : ∀ (p : E), nonzero p → s.Positive (v p)) :
  T.forward (v top) = one ∧
    (∀ (p : E), (F.scaled T).Value p (T.forward (v p))) ∧
      (∀ (p q : E), F.disjoint p q → T.forward (v (F.join p q)) = s.add (T.forward (v p)) (T.forward (v q))) ∧
        ∀ (p : E), nonzero p → s.Positive (T.forward (v p))
